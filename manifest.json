{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.5.6",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://baramsoft.com",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "copy-rich": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "MacCtrl+Shift+9"
      },
      "description": "__MSG_cmdCopy__"
    },
    "copy-rich-alternative": {
      "suggested_key": {
        "default": "Ctrl+Shift+8",
        "mac": "MacCtrl+Shift+8"
      },
      "description": "__MSG_cmdCopyAlt__"
    }
  }
}
